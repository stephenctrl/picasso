# Create an OpenAI API key at https://platform.openai.com/api-keys.
# Server only: never put this key in browser code or a VITE_ variable.
OPENAI_API_KEY=
# Default: gpt-5.4, for image input and strict structured-output design suggestions.
OPENAI_MODEL=gpt-5.4
# API base only; do not append /chat/completions.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: override OPENAI_MODEL and OPENAI_BASE_URL for an OpenAI-compatible
# provider supporting image input and Chat Completions strict JSON schema.
# Use that provider's key and an account-accessible model; not every provider works.
# OPENAI_MODEL=your-provider-model
# OPENAI_BASE_URL=https://your-provider.example/v1
# Local compatible providers may use loopback HTTP, e.g. http://127.0.0.1:1234/v1.