# Create a Gemini API key at https://aistudio.google.com/apikey (server only).
GEMINI_API_KEY=
# Choose a text model available to your key that supports structured JSON output.
GEMINI_MODEL=gemini-3.8-flash
# Google Gemini OpenAI-compatible API base; do not append /chat/completions.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai